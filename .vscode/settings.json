{
  // Editor formatting settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "notebook.formatOnCellExecution": true,
  "notebook.formatOnSave.enabled": true,
  "editor.formatOnType": true,

  // Remote development settings
  "remote.portsAttributes": {
    "3000": { "label": "Web", "onAutoForward": "openBrowser" }
  },
  "remote.autoForwardPorts": true,

  // Terminal and PowerShell settings
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass"]
    },
    "Windows PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass"]
    },
    "PowerShell 7": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "icon": "terminal-powershell",
      "args": ["-NoProfile"]
    }
  },

  // PowerShell extension settings
  "powershell.powerShellDefaultVersion": "Windows PowerShell",
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.integratedConsole.suppressStartupBanner": true,
  "powershell.scriptAnalysis.enable": false,

  // File encoding settings
  "files.encoding": "utf8",
  "terminal.integrated.unicode.version": "11",

  // Terminal performance optimization
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.fontFamily": "Cascadia Code, Consolas, 'Courier New'",
  "terminal.integrated.fontSize": 14,

  // GitHub Copilot Agent Mode settings
  "chat.agent.enabled": true,
  "chat.agent.maxRequests": 300,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.agent.runTasks": true,

  // Auto-approve terminal commands
  "chat.tools.terminal.enableAutoApprove": true,
  "chat.tools.terminal.autoApprove": {
    "rm": true,
    "rmdir": true,
    "del": true,
    "kill": true,
    "curl": true,
    "wget": true,
    "eval": true,
    "chmod": true,
    "chown": true,
    "Remove-Item": true
  },

  // Alternative: allowList / denyList approach
  "github.copilot.chat.agent.terminal.allowList": {
    "git": true,
    "npm": true,
    "yarn": true,
    "pnpm": true,
    "node": true,
    "npx": true,
    "echo": true,
    "cd": true,
    "ls": true,
    "cat": true,
    "pwd": true,
    "dir": true,
    "code": true,
    "tsc": true,
    "python": true,
    "python3": true,
    "pip": true
  },
  "github.copilot.chat.agent.terminal.denyList": {
    "rm": true,
    "rmdir": true,
    "del": true,
    "kill": true,
    "curl": true,
    "wget": true,
    "eval": true,
    "chmod": true,
    "chown": true,
    "Remove-Item": true,
    "Stop-Process": true
  }
}
